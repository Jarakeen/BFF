+++ b/minmax/tests/test_phase5_combat_math_validation.py
@@ -0,0 +1,436 @@
+"""Phase 5 combat-math validation suite.
+
+This is a *validation* pass, not a new combat system. It exercises the
+existing, already-implemented pipeline end to end:
+
+    database skill/morph coefficient
+        -> SkillCoefficientService / SkillDamageService   (minmax.skill_damage)
+        -> SkillDamageResult
+        -> calculate_skill_combat_damage                  (minmax.skill_combat_damage)
+        -> DDStatEvaluation (crit chance/damage, effective penetration)
+        -> calculate_dd_damage                             (minmax.dd_damage)
+        -> calculate_dd_mitigation                         (minmax.dd_mitigation)
+        -> final SkillCombatDamageResult
+
+No new production module is introduced by this file. Where a requested
+scenario (Damage Done modifier, Damage Taken modifier) has no wired
+implementation yet, the test documents that fact rather than inventing
+behavior — see the "gap-pinning" tests at the bottom.
+"""
+
+import sqlite3
+
+import pytest
+
+from services.eso_database import EsoDatabase
+
+from minmax.calculation import CalculationResult, StatBreakdown
+from minmax.evaluation_context import EvaluationContext
+from minmax.dd_stat_evaluation import evaluate_dd_stats
+from minmax.dd_mitigation import calculate_dd_mitigation
+from minmax.dd_damage import DDDamageResult
+from minmax.skill_coefficient_service import SkillCoefficientService
+from minmax.skill_damage import SkillDamageService, SkillDamageResult
+from minmax.skill_combat_damage import (
+    SkillCombatDamageResult,
+    calculate_skill_combat_damage,
+)
+
+
+# ---------------------------------------------------------------------------
+# Shared helpers
+# ---------------------------------------------------------------------------
+
+
+def make_calculation(**values) -> CalculationResult:
+    """Build a CalculationResult the same way test_dd_stat_evaluation.py does."""
+    stats = {
+        key: StatBreakdown(base=value)
+        for key, value in values.items()
+    }
+    return CalculationResult(stats=stats)
+
+
+BASE_HERO_SKILL_ID = 4410
+MORPH_A_SKILL_ID = 4411
+MORPH_B_SKILL_ID = 4412
+
+
+def create_coefficient_database(path):
+    """
+    Seed a throwaway sqlite DB with three distinct skill_rank_ids sharing
+    the shape of a base skill + two morphs, each with different a/b/c
+    coefficients -- the way real ESO base-skill/morph rows differ in
+    the production eso.db.
+    """
+    connection = sqlite3.connect(path)
+
+    connection.execute(
+        """
+        CREATE TABLE skill_coefficient (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            skill_rank_id INTEGER NOT NULL,
+            coefficient_number INTEGER NOT NULL,
+            type TEXT,
+            a REAL,
+            b REAL,
+            c REAL,
+            r REAL,
+            avg REAL
+        )
+        """
+    )
+
+    connection.executemany(
+        """
+        INSERT INTO skill_coefficient (
+            skill_rank_id, coefficient_number, type, a, b, c, r, avg
+        )
+        VALUES (?, ?, ?, ?, ?, ?, ?, ?)
+        """,
+        [
+            # Base skill: single coefficient component.
+            (BASE_HERO_SKILL_ID, 1, "8", 0.10, 1.50, 0.0, 1.0, None),
+            # Morph A: coefficients deliberately different from the base
+            # skill (higher scaling per weapon/spell damage).
+            (MORPH_A_SKILL_ID, 1, "8", 0.10, 2.00, 0.0, 1.0, None),
+            # Morph B: different again, and a disabled second component
+            # (type "-1") that must be excluded from the total, mirroring
+            # SkillDamageService's real filtering behavior.
+            (MORPH_B_SKILL_ID, 1, "8", 0.15, 1.50, 100.0, 1.0, None),
+            (MORPH_B_SKILL_ID, 2, "-1", -1.0, -1.0, -1.0, -1.0, None),
+        ],
+    )
+
+    connection.commit()
+    connection.close()
+
+
+@pytest.fixture
+def coefficient_service(tmp_path):
+    database_path = tmp_path / "eso.db"
+    create_coefficient_database(database_path)
+    database = EsoDatabase(database_path)
+    yield SkillCoefficientService(database)
+    database.close()
+
+
+@pytest.fixture
+def skill_damage_service(coefficient_service):
+    return SkillDamageService(coefficient_service)
+
+
+def resolve_skill_damage(
+    skill_damage_service,
+    skill_rank_id,
+    *,
+    max_stat=30000.0,
+    power=6000.0,
+) -> SkillDamageResult:
+    return skill_damage_service.evaluate(
+        skill_rank_id,
+        max_stat=max_stat,
+        power=power,
+    )
+
+
+# ---------------------------------------------------------------------------
+# Stage 1 (independent): coefficient resolution differs between morphs
+# ---------------------------------------------------------------------------
+
+
+def test_morph_coefficient_differs_from_base_skill(skill_damage_service):
+    """
+    A database-backed morph whose coefficient differs from its base skill
+    must resolve to a different total_raw_damage, even given identical
+    character stats. This proves coefficient resolution is genuinely
+    per-skill-rank-id, not a shared/cached formula.
+    """
+    base = resolve_skill_damage(skill_damage_service, BASE_HERO_SKILL_ID)
+    morph_a = resolve_skill_damage(skill_damage_service, MORPH_A_SKILL_ID)
+    morph_b = resolve_skill_damage(skill_damage_service, MORPH_B_SKILL_ID)
+
+    expected_base = 0.10 * 30000 + 1.50 * 6000 + 0.0
+    expected_morph_a = 0.10 * 30000 + 2.00 * 6000 + 0.0
+    expected_morph_b = 0.15 * 30000 + 1.50 * 6000 + 100.0
+
+    assert base.total_raw_damage == pytest.approx(expected_base)
+    assert morph_a.total_raw_damage == pytest.approx(expected_morph_a)
+    assert morph_b.total_raw_damage == pytest.approx(expected_morph_b)
+
+    # The whole point of a morph: distinct output for the same inputs.
+    assert base.total_raw_damage != morph_a.total_raw_damage
+    assert morph_a.total_raw_damage != morph_b.total_raw_damage
+
+
+def test_morph_disabled_component_is_excluded(skill_damage_service):
+    """Morph B has a type '-1' (disabled) second component that must not
+    contribute to total_raw_damage."""
+    morph_b = resolve_skill_damage(skill_damage_service, MORPH_B_SKILL_ID)
+
+    assert len(morph_b.components) == 1
+    assert morph_b.components[0].coefficient_number == 1
+
+
+# ---------------------------------------------------------------------------
+# Full chain: database skill -> final mitigated damage
+# ---------------------------------------------------------------------------
+
+
+def test_full_chain_non_critical(skill_damage_service):
+    """
+    Analytical lower bound: critical_chance = 0 means the expected-damage
+    stage contributes nothing beyond the raw scaled skill damage. This is
+    the deterministic equivalent of "a hit that does not crit" for an
+    engine that computes expected values rather than rolling dice.
+    """
+    skill_damage = resolve_skill_damage(skill_damage_service, MORPH_A_SKILL_ID)
+
+    calculation = make_calculation(
+        weapon_damage=3000,
+        spell_damage=3000,
+        physical_penetration=0,
+        spell_penetration=0,
+        critical_chance=0,
+        critical_damage=125,
+    )
+    stats = evaluate_dd_stats(calculation, EvaluationContext())
+
+    result = calculate_skill_combat_damage(skill_damage, stats)
+
+    assert isinstance(result, SkillCombatDamageResult)
+    assert result.damage.critical_chance == 0.0
+    assert result.damage.expected_damage == pytest.approx(
+        skill_damage.total_raw_damage
+    )
+    assert result.damage.mitigated_damage == pytest.approx(
+        skill_damage.total_raw_damage
+    )
+
+
+def test_full_chain_critical(skill_damage_service):
+    """
+    Analytical upper bound: critical_chance = 100(%) means every point of
+    critical_damage is fully realized in expected_damage. This is the
+    deterministic equivalent of "a hit that always crits."
+    """
+    skill_damage = resolve_skill_damage(skill_damage_service, MORPH_A_SKILL_ID)
+
+    calculation = make_calculation(
+        weapon_damage=3000,
+        spell_damage=3000,
+        critical_chance=100,
+        critical_damage=50,
+    )
+    stats = evaluate_dd_stats(calculation, EvaluationContext())
+
+    result = calculate_skill_combat_damage(skill_damage, stats)
+
+    expected = skill_damage.total_raw_damage * 1.5
+    assert result.damage.expected_damage == pytest.approx(expected)
+
+
+def test_full_chain_zero_penetration(skill_damage_service):
+    skill_damage = resolve_skill_damage(skill_damage_service, MORPH_A_SKILL_ID)
+
+    calculation = make_calculation(
+        weapon_damage=3000,
+        spell_damage=3000,
+        physical_penetration=0,
+    )
+    stats = evaluate_dd_stats(
+        calculation,
+        EvaluationContext(target_resistance=18200),
+    )
+
+    mitigation = calculate_dd_mitigation(
+        target_resistance=18200,
+        penetration=stats.effective_physical_penetration,
+    )
+
+    result = calculate_skill_combat_damage(
+        skill_damage,
+        stats,
+        damage_type="physical",
+        mitigation=mitigation,
+    )
+
+    assert stats.physical_overpenetration == 0.0
+    assert mitigation.mitigation_fraction == pytest.approx(0.364)
+    assert result.damage.mitigation_multiplier == pytest.approx(0.636)
+
+
+def test_full_chain_partial_penetration(skill_damage_service):
+    skill_damage = resolve_skill_damage(skill_damage_service, MORPH_A_SKILL_ID)
+
+    calculation = make_calculation(
+        weapon_damage=3000,
+        spell_damage=3000,
+        physical_penetration=9100,  # exactly half of 18200
+    )
+    stats = evaluate_dd_stats(
+        calculation,
+        EvaluationContext(target_resistance=18200),
+    )
+
+    mitigation = calculate_dd_mitigation(
+        target_resistance=18200,
+        penetration=stats.effective_physical_penetration,
+    )
+
+    result = calculate_skill_combat_damage(
+        skill_damage,
+        stats,
+        damage_type="physical",
+        mitigation=mitigation,
+    )
+
+    assert stats.physical_overpenetration == 0.0
+    assert mitigation.remaining_resistance == pytest.approx(9100)
+    assert mitigation.mitigation_fraction == pytest.approx(0.182)
+    assert result.damage.mitigation_multiplier == pytest.approx(0.818)
+
+
+def test_full_chain_penetration_reaches_target_resistance(skill_damage_service):
+    """Penetration exactly equal to target resistance must fully remove
+    mitigation (multiplier == 1.0), with zero overpenetration reported --
+    this is the boundary between "capped" and "wasted" penetration."""
+    skill_damage = resolve_skill_damage(skill_damage_service, MORPH_A_SKILL_ID)
+
+    calculation = make_calculation(
+        weapon_damage=3000,
+        spell_damage=3000,
+        physical_penetration=18200,
+    )
+    stats = evaluate_dd_stats(
+        calculation,
+        EvaluationContext(target_resistance=18200),
+    )
+
+    mitigation = calculate_dd_mitigation(
+        target_resistance=18200,
+        penetration=stats.effective_physical_penetration,
+    )
+
+    result = calculate_skill_combat_damage(
+        skill_damage,
+        stats,
+        damage_type="physical",
+        mitigation=mitigation,
+    )
+
+    assert stats.physical_overpenetration == 0.0
+    assert mitigation.remaining_resistance == 0.0
+    assert mitigation.mitigation_fraction == 0.0
+    assert result.damage.mitigation_multiplier == 1.0
+    assert result.damage.mitigated_damage == pytest.approx(
+        result.damage.expected_damage
+    )
+
+
+def test_full_chain_overpenetration(skill_damage_service):
+    """Penetration beyond target resistance must be reported as
+    overpenetration (wasted stat budget) and must not push the mitigation
+    multiplier above 1.0 (i.e. it cannot create bonus damage)."""
+    skill_damage = resolve_skill_damage(skill_damage_service, MORPH_A_SKILL_ID)
+
+    calculation = make_calculation(
+        weapon_damage=3000,
+        spell_damage=3000,
+        physical_penetration=20000,  # 1800 over an 18200 target
+    )
+    stats = evaluate_dd_stats(
+        calculation,
+        EvaluationContext(target_resistance=18200),
+    )
+
+    mitigation = calculate_dd_mitigation(
+        target_resistance=18200,
+        penetration=stats.effective_physical_penetration,
+    )
+
+    result = calculate_skill_combat_damage(
+        skill_damage,
+        stats,
+        damage_type="physical",
+        mitigation=mitigation,
+    )
+
+    assert stats.physical_overpenetration == 1800.0
+    assert stats.effective_physical_penetration == 18200.0
+    assert mitigation.mitigation_fraction == 0.0
+    assert result.damage.mitigation_multiplier == 1.0
+
+
+# ---------------------------------------------------------------------------
+# Damage Done / Damage Taken modifiers
+#
+# These formulas exist in the UESP reference (equations.py: DamageDone,
+# MagicDamageDone, PhysicalDamageDone, DamageTaken, ...) and their pure
+# Python translations exist (minmax/formulas/resolved_modifiers.py,
+# minmax/formulas/mitigations.py) -- but neither DDStatEvaluation nor
+# calculate_dd_damage nor calculate_skill_combat_damage currently accepts
+# or applies them. There is no StatId.DAMAGE_DONE / StatId.DAMAGE_TAKEN,
+# and EvaluationContext has no damage-taken-style field for the target.
+#
+# Per this task's instruction not to refactor existing math without a
+# demonstrated defect, these tests document current behavior rather than
+# adding new plumbing:
+#   - the one lever that DOES currently exist for "more damage done"
+#     (raising weapon_damage/spell_damage pre-crit) does flow through
+#     correctly end to end;
+#   - there is no dedicated post-crit multiplicative Damage Done/Taken
+#     stage, and this is pinned explicitly so a future change to add one
+#     is a conscious, visible edit to this test.
+# ---------------------------------------------------------------------------
+
+
+def test_current_damage_done_lever_is_pre_crit_offensive_power(
+    skill_damage_service,
+):
+    """
+    The only currently-wired way to represent a flat "more damage done"
+    style bonus is to raise the offensive power stat (weapon_damage /
+    spell_damage) that feeds SkillDamageService's `power` argument, since
+    that is what SkillCoefficientResult scales by. This test proves that
+    lever works proportionally, as a baseline for comparison against a
+    real Damage Done stage once one exists.
+    """
+    baseline = skill_damage_service.evaluate(
+        MORPH_A_SKILL_ID,
+        max_stat=30000,
+        power=6000,
+    )
+    boosted = skill_damage_service.evaluate(
+        MORPH_A_SKILL_ID,
+        max_stat=30000,
+        power=6600,  # +10% offensive power, standing in for "+10% damage done"
+    )
+
+    stats = evaluate_dd_stats(
+        make_calculation(weapon_damage=6000, spell_damage=0),
+        EvaluationContext(),
+    )
+
+    baseline_result = calculate_skill_combat_damage(baseline, stats)
+    boosted_result = calculate_skill_combat_damage(boosted, stats)
+
+    assert boosted_result.damage.expected_damage > baseline_result.damage.expected_damage
+
+
+def test_damage_done_and_damage_taken_have_no_dedicated_stage():
+    """
+    Gap-pinning test: DDDamageResult and DDStatEvaluation currently expose
+    no Damage Done / Damage Taken fields, and EvaluationContext has no
+    target-side damage-taken field. If this ever changes, this test
+    should be updated deliberately -- it is not meant to pass silently
+    through an unrelated refactor.
+    """
+    damage_fields = set(DDDamageResult.__dataclass_fields__)
+    assert "damage_done" not in damage_fields
+    assert "damage_taken" not in damage_fields
+    assert "cp_magic_damage_done" not in damage_fields
+
+    context_fields = set(EvaluationContext.__dataclass_fields__)
+    assert "damage_taken" not in context_fields
+    assert "target_damage_taken" not in context_fields
