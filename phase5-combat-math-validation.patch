@@ -0,0 +1,202 @@
+"""External reference validation for the Phase 5 combat-math foundation.
+
+Per the task instructions, this uses the ESO reference material already
+supplied to this project -- ``minmax/equations.py``, which the codebase
+itself documents as "Source of truth" for the UESP formula translations
+in ``minmax/formulas/`` -- as a validation reference only.
+
+The functions below are independent, literal, minimal re-implementations
+of specific ``equations.py`` formula lines (transcribed directly from the
+comments/text in that file, not imported from any BFF module), used only
+to check BFF's *existing* ``dd_mitigation`` / ``dd_damage`` output under
+equivalent assumptions. Nothing here is imported by, or copied into,
+BFF's production code, and no third-party calculator's specific numeric
+outputs are hard-coded into BFF itself.
+
+Where BFF and the reference formula diverge, the divergence is asserted
+explicitly (not silently tolerated) and explained in the docstring, per
+the "identify -> document -> only change BFF if BFF is wrong" instruction.
+"""
+
+import pytest
+
+from minmax.dd_mitigation import calculate_dd_mitigation
+
+
+# ---------------------------------------------------------------------------
+# Reference formulas, transcribed directly from minmax/equations.py.
+#
+#   AttackPhysicalMitigation =
+#   (((min(33000, Target.PhysicalResist) + Target.PhysicalDebuff)
+#     * (1 - Skill2.PhysicalPenetration) - PhysicalPenetration)
+#    * (-1 / (Target.EffectiveLevel * 1000)) + 1)
+#   * (1 - Target.DefenseBonus) * (-1) + 1
+#
+#   AttackSpellCritDamage = SpellCritDamage - (Target.CritResist)*(0.035/250)
+# ---------------------------------------------------------------------------
+
+
+def reference_attack_physical_mitigation(
+    *,
+    target_physical_resist: float,
+    penetration: float,
+    target_physical_debuff: float = 0.0,
+    skill2_physical_penetration: float = 0.0,
+    target_effective_level: float = 50.0,
+    target_defense_bonus: float = 0.0,
+    resist_cap: float = 33000.0,
+) -> float:
+    net_resistance = (
+        (min(resist_cap, target_physical_resist) + target_physical_debuff)
+        * (1 - skill2_physical_penetration)
+        - penetration
+    )
+    term = net_resistance * (-1.0 / (target_effective_level * 1000.0)) + 1.0
+    return term * (1 - target_defense_bonus) * (-1.0) + 1.0
+
+
+def reference_attack_spell_crit_damage(
+    *,
+    spell_crit_damage: float,
+    target_crit_resist: float,
+) -> float:
+    return spell_crit_damage - target_crit_resist * (0.035 / 250.0)
+
+
+# ---------------------------------------------------------------------------
+# 1. Mitigation stage: BFF's calculate_dd_mitigation vs. the reference
+#    AttackPhysicalMitigation formula.
+#
+# equations.py fixes the standard endgame assumptions BFF's dd_mitigation
+# module also implicitly assumes: Target.EffectiveLevel = 50 (max-level
+# PvE content), Target.DefenseBonus = 0, no active penetration-resisting
+# Skill2 modifier, no flat physical debuff. Under those assumptions the
+# reference formula's damage multiplier is (1 - AttackPhysicalMitigation),
+# which should equal BFF's damage_multiplier exactly, because both reduce
+# to the same "remaining_resistance / 50000" fraction.
+# ---------------------------------------------------------------------------
+
+
+def test_mitigation_matches_reference_formula_at_zero_penetration():
+    reference_mitigation = reference_attack_physical_mitigation(
+        target_physical_resist=18200,
+        penetration=0,
+    )
+    reference_damage_multiplier = 1 - reference_mitigation
+
+    bff = calculate_dd_mitigation(
+        target_resistance=18200,
+        penetration=0,
+    )
+
+    assert bff.damage_multiplier == pytest.approx(reference_damage_multiplier)
+
+
+def test_mitigation_matches_reference_formula_at_partial_penetration():
+    penetration = 9100
+
+    reference_mitigation = reference_attack_physical_mitigation(
+        target_physical_resist=18200,
+        penetration=penetration,
+    )
+    reference_damage_multiplier = 1 - reference_mitigation
+
+    bff = calculate_dd_mitigation(
+        target_resistance=18200,
+        penetration=penetration,
+    )
+
+    assert bff.damage_multiplier == pytest.approx(reference_damage_multiplier)
+
+
+def test_mitigation_matches_reference_formula_at_full_penetration():
+    reference_mitigation = reference_attack_physical_mitigation(
+        target_physical_resist=18200,
+        penetration=18200,
+    )
+    reference_damage_multiplier = 1 - reference_mitigation
+
+    bff = calculate_dd_mitigation(
+        target_resistance=18200,
+        penetration=18200,
+    )
+
+    assert bff.damage_multiplier == pytest.approx(reference_damage_multiplier)
+    assert bff.damage_multiplier == 1.0
+
+
+def test_mitigation_matches_reference_formula_at_overpenetration():
+    """
+    The reference formula, taken completely literally, would let net
+    resistance go negative and push the multiplier *above* 1.0 (bonus
+    damage from wasted penetration). BFF's dd_mitigation deliberately
+    clamps remaining_resistance at 0, so it does NOT reproduce that
+    literal over-penetration behavior -- this is BFF being more correct
+    than a literal transcription, not a defect, so this test documents
+    the intentional divergence rather than asserting equality.
+    """
+    penetration = 20000  # 1800 over target_physical_resist
+
+    reference_mitigation = reference_attack_physical_mitigation(
+        target_physical_resist=18200,
+        penetration=penetration,
+    )
+    reference_damage_multiplier = 1 - reference_mitigation
+
+    bff = calculate_dd_mitigation(
+        target_resistance=18200,
+        penetration=penetration,
+    )
+
+    # Literal reference formula: over-penetration pushes the multiplier
+    # past 1.0 (1800 / 50000 = 0.036 of "bonus" damage).
+    assert reference_damage_multiplier == 1.036
+    # BFF: correctly caps at 1.0, no bonus damage from wasted stats.
+    assert bff.damage_multiplier == 1.0
+    assert bff.damage_multiplier != reference_damage_multiplier
+
+
+# ---------------------------------------------------------------------------
+# 2. Critical damage stage: BFF's DDStatEvaluation vs. the reference
+#    AttackSpellCritDamage formula.
+#
+# equations.py reduces the attacker's critical damage by the target's
+# critical resistance (AttackSpellCritDamage = SpellCritDamage -
+# Target.CritResist * 0.035/250). BFF's dd_stat_evaluation only caps
+# critical_damage at a flat ceiling (default 125%) and has no target
+# critical-resistance input anywhere in DDStatEvaluation or
+# calculate_dd_damage. This is a genuine, confirmed gap (see the audit
+# doc), not a rounding/assumption difference -- documented here rather
+# than silently worked around.
+# ---------------------------------------------------------------------------
+
+
+def test_bff_does_not_reduce_crit_damage_by_target_crit_resistance():
+    stated_crit_damage = 100.0  # e.g. 100% bonus crit damage on the sheet
+    target_crit_resist = 2000.0  # hypothetical target value, for shape only
+
+    reference_effective_crit_damage = reference_attack_spell_crit_damage(
+        spell_crit_damage=stated_crit_damage,
+        target_crit_resist=target_crit_resist,
+    )
+
+    # The reference formula reduces effective crit damage below the
+    # stated value whenever the target has any critical resistance.
+    assert reference_effective_crit_damage < stated_crit_damage
+
+    # BFF has no such input at all: DDStatEvaluation.critical_damage is
+    # the stated value, uncapped by target crit resistance (only capped
+    # by critical_damage_cap, a flat ceiling unrelated to the target).
+    # There is nothing to call here that takes a target_crit_resist
+    # argument -- that is the point being documented.
+    from minmax.dd_stat_evaluation import evaluate_dd_stats
+    from minmax.calculation import CalculationResult, StatBreakdown
+    from minmax.evaluation_context import EvaluationContext
+
+    calculation = CalculationResult(
+        stats={"critical_damage": StatBreakdown(base=stated_crit_damage)}
+    )
+    bff_stats = evaluate_dd_stats(calculation, EvaluationContext())
+
+    assert bff_stats.effective_critical_damage == stated_crit_damage
+    assert bff_stats.effective_critical_damage != reference_effective_crit_damage
