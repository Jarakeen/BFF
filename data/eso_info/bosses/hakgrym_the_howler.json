    "dialogue": [
        {
            "speaker": "Hakgrym the Howler",
            "line": "You lost? No, I wager you're just where you want to be. Ha! Well, come on then!",
            "trigger": "Entering the arena",
            "ability": null
        },
        {
            "speaker": "",
            "line": "I'm right here, runts. Any time you're ready.",
            "trigger": "Idling before battle",
            "ability": null
        },
        {
            "speaker": "",
            "line": "You going to make me wait?",
            "trigger": "Idling before battle",
            "ability": null
        },
        {
            "speaker": "",
            "line": "The longer you make me wait, the sharper my swords get.",
            "trigger": "Idling before battle",
            "ability": null
        },
        {
            "speaker": "",
            "line": "You're right on time, runts. The lads here are starving!",
            "trigger": "Idling before battle",
            "ability": null
        },
        {
            "speaker": "",
            "line": "I'll try to make this quick. Heh. No promises.",
            "trigger": "Idling before battle",
            "ability": null
        },
        {
            "speaker": "",
            "line": "I won't lie to you. This is going to hurt.",
            "trigger": "Idling before battle",
            "ability": null
        },
        {
            "speaker": "",
            "line": "Ha! You have no idea what you're up against.",
            "trigger": "Entering battle",
            "ability": null
        },
        {
            "speaker": "",
            "line": "Let's see what you've got!",
            "trigger": "Entering battle",
            "ability": null
        },
        {
            "speaker": "",
            "line": "Finally. I've been itching for a scrap!",
            "trigger": "Entering battle",
            "ability": null
        },
        {
            "speaker": "",
            "line": "We're going to do this, eh? All right, let's go!",
            "trigger": "Entering battle",
            "ability": null
        },
        {
            "speaker": "",
            "line": "Time for the harvest!",
            "trigger": "Using Reaping Scythe",
            "ability": null
        },
        {
            "speaker": "",
            "line": "This is going to hurt!",
            "trigger": "Using Reaping Scythe",
            "ability": null
        },
        {
            "speaker": "",
            "line": "You think you know pain? Ha!",
            "trigger": "Using Reaping Scythe",
            "ability": null
        },
        {
            "speaker": "",
            "line": "Like grain before the scythe.",
            "trigger": "Using Reaping Scythe",
            "ability": null
        },
        {
            "speaker": "",
            "line": "This should keep you busy.",
            "trigger": "Summoning a Woeful Totem",
            "ability": null
        },
        {
            "speaker": "",
            "line": "Go fetch, mongrels!",
            "trigger": "Summoning a Woeful Totem",
            "ability": null
        },
        {
            "speaker": "",
            "line": "This should liven things up a bit.",
            "trigger": "Summoning a Woeful Totem",
            "ability": null
        },
        {
            "speaker": "",
            "line": "You've got nowhere to run.",
            "trigger": "Using Curse Ground",
            "ability": null
        },
        {
            "speaker": "",
            "line": "Dance for me, eh?",
            "trigger": "Using Curse Ground",
            "ability": null
        },
        {
            "speaker": "",
            "line": "I knew these things would come in handy.",
            "trigger": "Releasing a flesh abomination",
            "ability": null
        },
        {
            "speaker": "",
            "line": "Let's get these chains off you, eh? Time to play.",
            "trigger": "Releasing a flesh abomination",
            "ability": null
        },
        {
            "speaker": "",
            "line": "You hungry, boy? Eh? 'Course you are. Go get them!",
            "trigger": "Releasing a flesh abomination",
            "ability": null
        },
        {
            "speaker": "",
            "line": "You're pretty good! I guess it's time to call in the muscle.",
            "trigger": "Releasing a flesh abomination",
            "ability": null
        },
        {
            "speaker": "",
            "line": "Enough appetizers. Time for the main course!",
            "trigger": "Turning into a werewolf",
            "ability": null
        },
        {
            "speaker": "",
            "line": "You've got me bleeding all right. Let me return the favor!",
            "trigger": "Turning into a werewolf",
            "ability": null
        },
        {
            "speaker": "",
            "line": "You want a real fight, eh? Here it comes!",
            "trigger": "Turning into a werewolf",
            "ability": null
        },
        {
            "speaker": "",
            "line": "Too easy.",
            "trigger": "Group wipe",
            "ability": null
        },
        {
            "speaker": "",
            "line": "Orkey's blood, I thought you'd give me a challenge! Too bad.",
            "trigger": "Group wipe",
            "ability": null
        },
        {
            "speaker": "",
            "line": "Don't worry, I'll make good use of your corpses.",
            "trigger": "Group wipe",
            "ability": null
        },
        {
            "speaker": "",
            "line": "What lies beyond the door? Ha! Guess you'll never know.",
            "trigger": "Group wipe",
            "ability": null
        },
        {
            "speaker": "",
            "line": "Least you died in a graveyard, eh? Convenient.",
            "trigger": "Group wipe",
            "ability": null
        }
    ],
