/* =====================================================
   Black Feather Foundry
   # assets/themes/bff/Foundry.qss
   ===================================================== */

QWidget {
    background-color: #171717;
    color: #E8E3D6;
    font-size: 10pt;
}
QFrame#card {
    background-color: #202020;
    border: 1px solid #343434;
    border-radius: 8px;
    padding: 10px;
}

QLabel#cardTitle {
    color: #C79A4A;
    font-weight: bold;
    font-size: 14px;
}
