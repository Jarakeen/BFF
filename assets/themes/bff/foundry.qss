FOUNDRY_THEME = """
/* ==========================================================
   BLACK FEATHER FOUNDRY
   Chocolate / Bronze Theme
   ========================================================== */

QMainWindow,
QWidget {
    background-color: #120f0c;
    color: #e8dfd0;
    font-family: "Segoe UI";
    font-size: 14px;
}

/* ----------------------------------------------------------
   Main surfaces
   ---------------------------------------------------------- */

QScrollArea,
QScrollArea > QWidget > QWidget {
    background-color: #120f0c;
    border: none;
}

QGroupBox {
    background-color: #1a1511;
    border: 1px solid #493a2a;
    border-radius: 7px;
    margin-top: 18px;
    padding: 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 8px;
    color: #c99643;
    background-color: #120f0c;
    font-family: "Georgia";
    font-size: 15px;
    font-weight: bold;
}

/* ----------------------------------------------------------
   Sidebar
   ---------------------------------------------------------- */

QWidget#sidebar {
    background-color: #0d0a08;
    border-right: 1px solid #493a2a;
}

QLabel#brandMark {
    color: #c99643;
    font-size: 32px;
}

QLabel#brandTitle {
    color: #eee5d6;
    font-family: "Georgia";
    font-size: 25px;
    font-weight: bold;
}

QLabel#brandSubtitle {
    color: #c99643;
    font-family: "Georgia";
    font-size: 13px;
    letter-spacing: 2px;
}

QLabel#reminder {
    color: #a99d8d;
    font-size: 12px;
    line-height: 1.5;
}

QLabel#sidebarFooter {
    color: #756958;
    font-size: 10px;
}

/* ----------------------------------------------------------
   Page headings
   ---------------------------------------------------------- */

QLabel#pageTitle {
    color: #f0e6d5;
    font-family: "Georgia";
    font-size: 30px;
    font-weight: bold;
}

QLabel#pageSubtitle {
    color: #b28a51;
    font-size: 12px;
    letter-spacing: 1px;
}

QLabel#statusLabel {
    color: #8f806e;
    padding-top: 4px;
}

/* ----------------------------------------------------------
   Navigation
   ---------------------------------------------------------- */

QPushButton[nav="true"] {
    background-color: transparent;
    border: 1px solid #33281d;
    border-radius: 5px;
    color: #cfc4b4;
    padding: 10px 12px;
    text-align: left;
}

QPushButton[nav="true"]:hover {
    background-color: #211910;
    border-color: #76572d;
    color: #f0e6d5;
}

QPushButton[nav="true"]:checked {
    background-color: #6e4a20;
    border-color: #a87932;
    color: #fff3df;
}

/* ----------------------------------------------------------
   Inputs
   ---------------------------------------------------------- */

QLineEdit,
QComboBox,
QSpinBox,
QTextEdit,
QListWidget,
QTreeWidget {
    background-color: #17120e;
    border: 1px solid #4b3a29;
    border-radius: 5px;
    color: #e9dfd0;
    padding: 7px;
    selection-background-color: #765225;
    selection-color: #fff5e6;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QTextEdit:focus,
QListWidget:focus,
QTreeWidget:focus {
    border-color: #b17b31;
}

/* ----------------------------------------------------------
   Combo boxes
   ---------------------------------------------------------- */

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background-color: #1b1510;
    border: 1px solid #6d512e;
    color: #eee5d6;
    selection-background-color: #6e4a20;
}

/* ----------------------------------------------------------
   Checkboxes
   ---------------------------------------------------------- */

QCheckBox {
    color: #d9cfbf;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
}

QCheckBox::indicator:unchecked {
    background-color: #17120e;
    border: 1px solid #67533a;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #b07b32;
    border: 1px solid #d3a65d;
    border-radius: 3px;
}

/* ----------------------------------------------------------
   Buttons
   ---------------------------------------------------------- */

QPushButton {
    background-color: #6b481d;
    border: 1px solid #9a6c2d;
    border-radius: 5px;
    color: #fff1dc;
    padding: 9px 16px;
}

QPushButton:hover {
    background-color: #805827;
    border-color: #c09249;
}

QPushButton:pressed {
    background-color: #503414;
}

QPushButton:disabled {
    background-color: #29221b;
    border-color: #3d3328;
    color: #71675b;
}

/* ----------------------------------------------------------
   Lists / trees
   ---------------------------------------------------------- */

QListWidget,
QTreeWidget {
    alternate-background-color: #1d1712;
}

QTreeWidget::item:selected,
QListWidget::item:selected {
    background-color: #65451f;
    color: #fff1dc;
}

QHeaderView::section {
    background-color: #211910;
    border: 1px solid #493a2a;
    color: #c99643;
    padding: 7px;
}

/* ----------------------------------------------------------
   Scrollbars
   ---------------------------------------------------------- */

QScrollBar:vertical {
    background: #0e0b09;
    width: 11px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #58442c;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #856332;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0;
}

QScrollBar:horizontal {
    background: #0e0b09;
    height: 11px;
}

QScrollBar::handle:horizontal {
    background: #58442c;
    border-radius: 5px;
}

/* ----------------------------------------------------------
   Bronze separators
   ---------------------------------------------------------- */

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #493a2a;
}
"""